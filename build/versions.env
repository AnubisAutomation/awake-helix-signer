RUSTUP_VERSION=1.29.3
# BuildKit for the script's own image builder (build.sh/build.ps1 only, not a build argument)
BUILDKIT_IMAGE=moby/buildkit:v0.33.0
TAURI_CLI_VERSION=2.12.4
TAURI_DRIVER_VERSION=2.1.0
CARGO_XWIN_VERSION=0.23.1
UV_VERSION=0.12.15
PYTHON_VERSION=3.12
ETH_ACCOUNT_VERSION=0.13.7
ANDROID_CMDLINE_TOOLS=16111833
ANDROID_CMDLINE_TOOLS_SHA1=e025545c62a8e64c7559119566a569fb1dec5f60
ANDROID_PLATFORMS='android-36 android-37.0'
ANDROID_BUILD_TOOLS=36.0.0
ANDROID_NDK_VERSION=28.2.13676358
ANDROID_EMULATOR_IMAGE='system-images;android-34;default;x86_64'

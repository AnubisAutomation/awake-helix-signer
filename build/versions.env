# Pinned tool versions for every signer build (sourced by build.sh, passed to
# the Dockerfiles as build arguments; the native macOS/iOS path checks them).
# The Rust toolchain is pinned in ../rust-toolchain.toml and the npm packages
# (including the Tauri CLI) in ../app/package-lock.json.
NODE_VERSION=24.22.2
NODE_SHA256_X64=48cc0e21e048790e54c0cf5749c2725005313d652651c40b7a21feb9697aaf75

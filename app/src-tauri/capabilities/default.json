{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The signer window: its own commands, deep links, and reading/writing only the files the user picks.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "deep-link:default",
    "dialog:allow-open",

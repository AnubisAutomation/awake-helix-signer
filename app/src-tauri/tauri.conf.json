{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Anubis Automation Script Signer",
  "version": "0.7.0",
  "identifier": "com.sivilization.anubisauto.signer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Anubis Automation Script Signer",
        "width": 940,
        "height": 800,
        "minWidth": 360,
        "minHeight": 520,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'",
      "freezePrototype": true
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Sivilization",
    "copyright": "Sivilization",
    "category": "Finance",
    "shortDescription": "Authorize and revoke Anubis Automation hosted bots with your own key.",
    "longDescription": "Anubis Automation Script Signer verifies the website's plan against constants built into the app, shows a summary decoded from the calldata, and signs EIP-7702 grants and revocations with a key that never leaves this device.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": { "section": "utils" },
      "appimage": { "bundleMediaFramework": false }
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/hooks.nsh",
        "languages": ["English", "TradChinese", "SimpChinese", "Japanese", "Korean", "Spanish"],
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "hardenedRuntime": true
    },
    "android": {
      "minSdkVersion": 24
    },
    "iOS": {
      "minimumSystemVersion": "15.0"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["anubisauto", "awakehelix"] },
      "mobile": [{ "scheme": ["anubisauto", "awakehelix"], "appLink": false }]
    }
  }
}

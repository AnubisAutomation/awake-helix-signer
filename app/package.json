{
  "name": "awake-helix-signer-app",
  "private": true,
  "version": "0.5.3",
  "type": "module",
  "description": "Awake Helix Signer: the Tauri 2 app (frontend).",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/icon.mjs src-tauri/app-icon.png && tauri icon src-tauri/app-icon.png -o src-tauri/icons",
    "tauri": "tauri",
    "e2e": "node e2e/run.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-deep-link": "2.6.2",
    "@tauri-apps/plugin-dialog": "2.8.3",
    "@tauri-apps/plugin-fs": "2.7.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "jsdom": "30.1.3",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22.12"
  }
}
